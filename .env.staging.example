# STAGING ONLY. NOT PRODUCTION. All values here are placeholders, not usable
# secrets. Populate real values only in the staging secret manager or runner.

# REQUIRED | STAGING ONLY | SERVER ONLY
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXTAUTH_URL=https://staging.example.invalid
NEXTAUTH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_STAGING_SECRET_AT_LEAST_32_BYTES
RESUME_STORAGE_DIR=/srv/genz-staging/private-resumes

# REQUIRED | STAGING ONLY | CLIENT SAFE (public origin only; contains no secret)
NEXT_PUBLIC_APP_URL=https://staging.example.invalid

# At least one provider key is required by production startup validation.
# The requested model (ChatGPT or Gemini) selects the adapter per operation;
# there is no AI_PROVIDER environment variable or automatic cross-provider fallback.
# OPTIONAL INDIVIDUALLY | STAGING ONLY | SERVER ONLY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL | STAGING ONLY | SERVER ONLY | STRIPE TEST MODE ONLY
# Leave all Stripe fields empty to keep checkout disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_CREDIT_PACK_STARTER_PRICE_ID=
STRIPE_CREDIT_PACK_PLUS_PRICE_ID=
STRIPE_CREDIT_PACK_PRO_PRICE_ID=

# OPTIONAL FOR APP RUNTIME | STAGING ONLY | TEST RUNNER ONLY
# E2E_BASE_URL and E2E_ENVIRONMENT are required to run the suite;
# E2E_TARGET_CONFIRM is required only for a remote HTTPS target.
# Never publish these as browser variables.
E2E_BASE_URL=https://staging.example.invalid
E2E_ENVIRONMENT=staging
E2E_TARGET_CONFIRM=staging.example.invalid

# LOCAL ONLY (not configured below): use .env, .env.postgres, and compose.yaml
# for local development only. Never copy their values into staging.

# EMAIL: no email provider is implemented, so there are no EMAIL_* settings.
