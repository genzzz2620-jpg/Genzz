# Development template only. Copy to .env for local development.
# Never use these values as production credentials; configure each environment
# through its secret manager or deployment platform.

# Development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
RESUME_STORAGE_DIR=./data/private-resumes

# AI providers (configure at least one server-side key for AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional admin usage estimates (USD per 1 million tokens; estimates only)
AI_OPENAI_INPUT_USD_PER_MILLION=
AI_OPENAI_OUTPUT_USD_PER_MILLION=
AI_GEMINI_INPUT_USD_PER_MILLION=
AI_GEMINI_OUTPUT_USD_PER_MILLION=

# Optional billing display and entitlements
PAYMENT_PROVIDER=stripe
PREMIUM_PRICE_DISPLAY=
PREMIUM_BILLING_INTERVAL=Monthly
FREE_AI_REQUESTS_PER_MINUTE=8
FREE_AI_REQUESTS_PER_DAY=100
PREMIUM_AI_REQUESTS_PER_MINUTE=20
PREMIUM_AI_REQUESTS_PER_DAY=500

# Stripe billing (all three secrets/IDs are required to enable checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_CREDIT_PACK_STARTER_PRICE_ID=
STRIPE_CREDIT_PACK_PLUS_PRICE_ID=
STRIPE_CREDIT_PACK_PRO_PRICE_ID=
PRACTICE_SESSION_COST_UNITS=100
FREE_PRACTICE_SESSIONS_PER_MONTH=1
FREE_PRACTICE_COOLDOWN_HOURS=24
FREE_PRACTICE_DURATION_MINUTES=30
PAID_PRACTICE_DURATION_MINUTES=60

# Optional demo seeding only; demo seeding is disabled in production.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Production and test environments should set their own canonical URLs,
# database credentials, auth secret, AI keys, and Stripe values independently.
# Prisma currently reads DATABASE_URL only; DIRECT_DATABASE_URL is not used.
